programa
{
	funcao inicio()
	{
		inteiro n1
		inteiro n2
		inteiro n3
		escreva("Digite os três números inteiros abaixo de dois dígitos!(pressione enter a cada entrada) ")
		leia(n1,n2,n3)
		limpa()
		se (n1 >= 10)
		{
			escreva ("DIGITO Nº 1 INVALIDO")
		}
			senao se (n2 >= 10)
			{
				escreva("DIGITO Nº 2 INVALIDO")
			}
			senao se (n3 >= 10)
			{
				escreva("DIGITO Nº 3 INVALIDO")
			}
			senao
			{
				real mult1 = (n2*0.1)
				real mult2 = (n3*0.01)
				inteiro soemu = (n1+mult1+mult2)*(100)
				inteiro pot = (soemu*soemu)
				escreva(soemu,", ",pot)
			}
	}
}
