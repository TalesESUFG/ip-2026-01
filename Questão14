programa
{
	inclua biblioteca Matematica --> m
	funcao inicio()
	{
		real h
		real a
		real r = m.raiz(3, 2)
		escreva("Qual a altura e aresta da pirâmide?(enter para cada entrada) ")
		leia(h,a)
		limpa()
		real ar = 3*(a*a*r)/2
		real v = (ar*h)*1/3
		v = m.arredondar(v, 2)
		escreva("O volume da pirâmide é: ",v," metros cúbicos")
	}
}
