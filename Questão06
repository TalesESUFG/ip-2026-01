programa
{
	inclua biblioteca Matematica --> mat
	funcao inicio()
	{
		inteiro n
		inteiro nr = 0
		escreva("Qual a quantidade de operações que você deseja realizar? ")
		leia(n)
		limpa()
		enquanto (nr < n) //novamente, não ache que é possível guardar os dados do loop para colocar todos os resultados ao mesmo tempo.
		{
			nr = nr+1
			real nf
			escreva("Qual o número que você quer transformar de Fahrenheit para Celsius? ")
			leia(nf)
			limpa()
			real cv = 5*(nf-32)/9
			cv = mat.arredondar(cv, 2)
			escreva(nf," Fahrenheit equivale a ",cv," Celcius")
		}
	}
}
