programa
{
	funcao inicio()
	{
		inteiro n
		inteiro c
		escreva("Escreva um número par e a quantidade de números pares após ele.(enter para cada entrada) ")
		leia(n,c)
		limpa()
		inteiro i = 0
		se(n%2 != 0)
		{
			escreva("O primeiro número não é par.")
		}
		senao
		{
			enquanto(i < c)
			{
				escreva(n," ")
				n = n+2
				i = i+1
			}
		}
	}
}
