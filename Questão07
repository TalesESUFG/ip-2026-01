programa
{
	inclua biblioteca Matematica --> mat
	funcao inicio()
	{
		real fr
		escreva("Qual a temperatura em Fahrenheit? ")
		leia(fr)
		limpa()
		real cv = (5*fr-160)/9
		cv = mat.arredondar(cv, 2)
		real pl
		escreva("Qual a quantidade de chuva em polegadas? ")
		leia(pl)
		limpa()
		real mm = (pl*25.4)
		mm = mat.arredondar(mm, 2)
		escreva("A temperatura em Celsius: ",cv,"\nA quantidade de chuva em milímetros: ",mm)
	}
}
