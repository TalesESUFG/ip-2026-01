programa
{
	inclua biblioteca Matematica --> m
	funcao inicio()
	{
		real s
		escreva("Qual o seu salário? ")
		leia(s)
		limpa()
		se (s <= 300)
		{
			real r1 = s*0.5
			real cl = r1+s
			cl = m.arredondar(cl, 2)
			escreva("Salário com reajuste: ",cl)
		}
		senao
		{
			real r2 = s*0.3
			real cl2 = r2+s
			cl2 = m.arredondar(cl2, 2)
			escreva("Salário com reajuste: ",cl2)
		}
	}
}
