programa {
  inclua biblioteca Matematica --> mat
  funcao inicio() {
    real conta
    real consumo
    cadeia tipo
    escreva("Qual sua conta, consumo e tipo?(Digite a incial do tipo em minúsculo, aperte enter a cada entrada)\n")
    leia(conta,consumo,tipo)
    limpa()
    se(tipo == "r")
    {
      real residencial = 5.00
      real valor1 = (consumo * 0.05)+residencial
      mat.arredondar(valor1, 100)
      escreva("Conta: ",conta,"\nValor da conta: ",valor1)
  }
    senao se(tipo == "c")
    {
      real comercial = 500.00
      real valor2 = (consumo * 0.25)+comercial
      mat.arredondar(valor2, 100)
      escreva("Conta: ",conta,"\nValor da conta: ",valor2)
    }
    senao se(tipo == "i")
    {
      real industrial = 800.00
      real valor3 = (consumo * 0.04)+industrial
      mat.arredondar(valor3, 100)
      escreva("Conta: ",conta,"\nValor da conta: ",valor3)
    }
  }
}
