programa
{	
	inclua biblioteca Matematica --> mat
	funcao inicio()
	{
		real sm
		real gs
		escreva("Qual o valor do salário mínimo e qual foi o gasto em kW da residência?(aperte enter para cada entrada)\n")
		leia(sm,gs)
		limpa()
		real cemkw = (sm*0.7)
		real umkw = (cemkw/100)
		real gskw = (umkw*gs)
		real gsdc = (gskw*0.9)
		umkw = mat.arredondar(umkw, 2)
		gskw = mat.arredondar(gskw, 2)
		gsdc = mat.arredondar(gsdc, 2)
		escreva("Custo por kW: ",umkw,"\nCusto do consumo: ",gskw,"\nCusto com desconto: ",gsdc)
	}
}
